                  "// Signs the exact request body with HMAC-SHA256, as the payment provider would.",
                  "// The secret must match WEBHOOK_SECRET on the server (default below).",
                  "pm.variables.set('event_id', 'evt_' + Date.now());",
                  "const secret = pm.variables.get('webhook_secret') || 'test-webhook-secret-key';",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
